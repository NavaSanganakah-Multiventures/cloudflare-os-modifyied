{
  "name": "developer-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVELOPER_API_GATEWAY",
        "class_name": "DeveloperApiGateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeveloperApiGateway"
      ]
    }
  ],
  "vars": {
    "GITHUB_OWNER": "NavaSanganakah-Multiventures",
    "GITHUB_REPO": "cloudflare-os-modifyied"
  },
  "env": {
    "production": {
      "vars": {
        "GITHUB_OWNER": "NavaSanganakah-Multiventures",
        "GITHUB_REPO": "cloudflare-os-modifyied"
      }
    }
  }
}