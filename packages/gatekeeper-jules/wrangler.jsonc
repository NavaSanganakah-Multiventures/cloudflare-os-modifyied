{
  "name": "cloudflareos-gk-jules",
  "main": ".wrangler/validate/src/jules.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "JulesGatekeeperImpl"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
