{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflareos-gk-context",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "nodejs_compat",
    "allow_irrevocable_stub_storage"
  ],

  // DO classes are reached via ctx.exports; no durable_objects binding needed.
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [
        "ContextCollectionDurableObject",
        "UserLibraryDurableObject",
        "LibraryRegistryDurableObject",
        "ContextGatekeeper"
      ]
    }
  ],

  // Public-collections snapshot KV. preview_id preserves existing dev data.
  "kv_namespaces": [
    {
      "binding": "CONTEXT_COLLECTIONS",
      "preview_id": "gadgets-context-collections",
      "id": "fef31adef1a64ccc8efcbe22acfba5ff"
    }
  ],

  // Optional: add an Artifacts binding named ARTIFACTS to enable Git-backed collections.
  // Optional: Workers AI binding for OCR text extraction from images.
  // In dev, run-dev-server.js injects this with --use-workers-ai-binding.
  // In production, deploy.yml injects this for the gatekeeper-context worker.
  // For self-hosted workerd without Workers AI, leave it unconfigured;
  // the code degrades gracefully (image OCR skipped, PDF/Office extraction still works).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }

}
